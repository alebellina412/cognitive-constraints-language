# Raw corpora — downloaded, never redistributed (see docs/DATA.md)
data_raw/*
!data_raw/.gitkeep

# Simulated trajectories and the D0 sweep — regenerated by notebook 7
sim_trajectories
data_raw_link
data_reduced/sim_*
outputs/d0_calibration*/

# The C simulator writes its per-run summaries to `data/` relative to whatever
# directory it was started from, so running the notebooks drops a few hundred MB
# into notebooks/data/. Nothing reads these back — every trajectory the pipeline
# consumes is written to a temporary directory and reduced there.
data/
notebooks/data/
n_UMT_*.dat
*.cltraj.zst

# Generated outputs
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

work/

# Compiled simulator
sim/tests/umt_legacy
sim/tests/umt_zstd
sim/tests/umt_fast_zstd
sim/tests/legacy_run/
sim/tests/compressed_run/
*.o

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Editors / OS
.DS_Store
*.swp
